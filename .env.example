## Copy this file to .env and uncomment any settings you want to override.

## Optional: enable password protection for the web server and native clients.
## If unset, the server serves data without authentication.
#NARA_PASSWORD=replace-with-a-strong-password

## Optional: host for the web server.
## If unset, defaults to 127.0.0.1 (local system only).
## Set to 0.0.0.0 to allow access from other devices on the network.
#NARA_HOST=127.0.0.1
#NARA_HOST=0.0.0.0

## Optional: port for the web server.
## If unset, defaults to 8787.
#NARA_PORT=8787

## Optional: how long nara_web.py keeps fetched data in memory before pulling again.
## Value is in seconds.
#NARA_CACHE_TTL=10

## Optional: how long each ADB operation may run before failing with diagnostics.
## Value is in seconds.
#NARA_ADB_TIMEOUT=10

## Optional: specific adb device / emulator serial to use.
## You can also use ANDROID_SERIAL, which is the standard env variable for adb.
## If both are set, ADB_DEVICE takes precedence over ANDROID_SERIAL.
#ADB_DEVICE=emulator-5554

## Optional: path to the adb executable.
#ADB_PATH=adb
