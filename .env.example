## Copy this file to .env and uncomment any settings you want to override.

## Optional: enable password protection for the web server and native clients.
## If unset, the server serves data without authentication.
#NARA_PASSWORD=replace-with-a-strong-password

## Optional: host for the web server.
## If unset, defaults to 127.0.0.1 (local system only).
## Set to 0.0.0.0 to allow access from other devices on the network.
#NARA_HOST=127.0.0.1
#NARA_HOST=0.0.0.0

## Optional: port for the web server.
## If unset, defaults to 8787.
#NARA_PORT=8787

## Optional: how long nara_web.py keeps fetched data in memory before pulling again.
## Value is in seconds.
#NARA_CACHE_TTL=10

## Optional: how long each ADB operation may run before failing with diagnostics.
## Value is in seconds.
#NARA_ADB_TIMEOUT=10

## Optional: specific adb device / emulator serial to use.
## You can also use ANDROID_SERIAL, which is the standard env variable for adb.
## If both are set, ADB_DEVICE takes precedence over ANDROID_SERIAL.
#ADB_DEVICE=emulator-5554

## Optional: path to the adb executable. It is normally found automatically
## from PATH, ANDROID_SDK_ROOT, ANDROID_HOME, or the standard SDK location.
#ADB_PATH=adb

##### ANDROID EMULATOR SETTINGS
## Set these to enable automatic supervision of an Android emulator for
## Nara Baby, which Nara Gaiden uses to read the app's databases.
## Otherwise, you're responsible for running the emulator yourself.

## Optional: start and supervise an Android emulator with the server.
## Set this to the AVD name shown by: emulator -list-avds
## Before enabling this, launch that AVD manually and sign into Nara Baby once.
## When unset, emulator/app supervision is disabled.
#NARA_EMULATOR_AVD=Medium_Tablet_API_35

## Optional: path to the Android emulator executable. It is normally found
## automatically from PATH, ANDROID_SDK_ROOT, ANDROID_HOME, or ADB_PATH.
#NARA_EMULATOR_PATH=C:\Users\you\AppData\Local\Android\Sdk\emulator\emulator.exe

## Optional: extra arguments passed to the emulator process. It defaults to
## `-no-window -no-audio -no-boot-anim` for unattended server operation.
## Set this to an empty value to restore the emulator's normal visible behavior.
#NARA_EMULATOR_ARGS=

## Optional: name of Android package for the Nara Baby app, which the
## emulator keeps in foreground and whose databases Nara Gaiden reads.
#NARA_APP_PACKAGE=com.naraorganics.nara

## Optional: supervision cadence and consecutive ADB failures before recovery.
#NARA_EMULATOR_CHECK_INTERVAL=60
#NARA_EMULATOR_FAILURE_THRESHOLD=3

## Optional: initial boot grace period before a booting emulator is considered hung.
#NARA_EMULATOR_BOOT_TIMEOUT=180
